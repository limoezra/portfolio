---
import { site } from '../data/site';
const { profile, stats } = site;
---

<section class="hero wrap" id="top">
  <div class="copy">
    <p class="eyebrow" data-intro>{profile.org} · {profile.location} · {profile.coords}</p>
    <h1 data-intro-name>{profile.name}</h1>
    <p class="role" data-intro>{profile.role}</p>
    <p class="pitch" data-intro>{profile.pitch}</p>
    <div class="ctas" data-intro>
      <a class="btn primary" href="#research">See my work</a>
      <a class="btn" href="#contact">Get in touch</a>
    </div>
    <dl class="stats" data-intro>
      {
        stats.map((s) => (
          <div>
            <dt>
              <span data-count={s.value}>{s.value}</span>
              {s.suffix}
            </dt>
            <dd>{s.label}</dd>
          </div>
        ))
      }
    </dl>
  </div>

  <figure class="viz" data-intro>
    <canvas class="map" data-hero-map role="img" aria-label="Animated rainfall map of the Greater Horn of Africa. Move the pointer over it to add rain."
    ></canvas>
    <figcaption>
      <span class="mono">ensemble member <b data-sample>1</b>/5 · 0.1° grid</span>
      <button class="btn sample" type="button" data-resample>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 12a8 8 0 0 1 14-5.3M20 12a8 8 0 0 1-14 5.3M18 3v4h-4M6 21v-4h4"></path></svg>
        New sample
      </button>
    </figcaption>
    <p class="hint mono" aria-hidden="true">move your cursor over the map to make it rain</p>
  </figure>
</section>

<script>
  import { mountHero } from '../scripts/rain';
  import { initMotion, reduced } from '../scripts/motion';

  const hero = mountHero(document.querySelector<HTMLCanvasElement>('[data-hero-map]')!, { reduced });
  const label = document.querySelector('[data-sample]')!;
  document.querySelector('[data-resample]')!.addEventListener('click', () => {
    label.textContent = String(hero.resample());
  });
  initMotion();
</script>

<style>
  .hero {
    min-height: calc(100svh - var(--nav-h));
    display: grid;
    grid-template-columns: 1.05fr 1fr;
    align-items: center;
    gap: clamp(32px, 5vw, 80px);
    padding-block: clamp(40px, 6vw, 80px);
  }
  h1 {
    font-size: clamp(3.4rem, 9vw, 7.4rem);
    font-weight: 800;
    letter-spacing: -0.045em;
    line-height: 0.92;
    margin-bottom: 18px;
  }
  .role {
    font: 500 clamp(0.9rem, 1.3vw, 1.05rem) / 1.4 var(--f-mono);
    color: var(--accent);
    margin-bottom: 22px;
  }
  .pitch {
    font-size: clamp(1.1rem, 1.7vw, 1.3rem);
    color: var(--muted);
    max-width: 34ch;
    margin-bottom: 32px;
  }
  .ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-bottom: 48px;
  }
  .stats {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
    margin: 0;
    border-top: 1px solid var(--line);
    padding-top: 22px;
  }
  .stats dt {
    font: 700 clamp(2rem, 3.4vw, 2.8rem) / 1 var(--f-display);
    background: linear-gradient(120deg, var(--accent), var(--accent-2));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .stats dd {
    margin: 6px 0 0;
    font-size: 0.85rem;
    color: var(--muted);
    line-height: 1.4;
  }
  .viz {
    margin: 0;
    position: relative;
  }
  canvas {
    width: 100%;
    aspect-ratio: 352 / 384;
    cursor: crosshair;
  }
  figcaption {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    flex-wrap: wrap;
    margin-top: 12px;
    font-size: 0.8rem;
    color: var(--muted);
  }
  figcaption b {
    color: var(--accent);
    font-weight: 500;
  }
  .sample {
    padding: 9px 16px;
    font-size: 0.88rem;
  }
  .sample svg {
    width: 16px;
    height: 16px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
    transition: transform 0.6s var(--ease);
  }
  .sample:hover svg {
    transform: rotate(180deg);
  }
  .hint {
    position: absolute;
    top: 6px;
    right: 0;
    margin: 0;
    font-size: 0.7rem;
    color: var(--muted);
    opacity: 0.7;
  }
  @media (hover: none) {
    .hint {
      display: none;
    }
  }
  @media (max-width: 900px) {
    .hero {
      grid-template-columns: 1fr;
      min-height: 0;
    }
    .viz {
      max-width: 520px;
      width: 100%;
      margin-inline: auto;
    }
  }
  @media (max-width: 480px) {
    .stats {
      gap: 12px;
    }
    .stats dd {
      font-size: 0.75rem;
    }
  }
</style>
