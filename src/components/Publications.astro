---
import { site } from '../data/site';

// Bold Ezra's name inside each author list.
const mark = (authors: string) => authors.replace(/Kiplimo, E\./, '<b>Kiplimo, E.</b>');
---

<section class="section wrap" id="publications">
  <p class="eyebrow">Publications</p>
  <h2 class="h2" data-scramble>In print</h2>
  <ol class="list" data-stagger>
    {
      site.publications.map((p) => (
        <li>
          <span class="year">{p.year}</span>
          <div>
            <h3>{p.title}</h3>
            <p class="authors" set:html={mark(p.authors)} />
            {p.venue && <p class="venue mono">{p.venue}</p>}
          </div>
        </li>
      ))
    }
  </ol>
</section>

<style>
  .h2 {
    margin-bottom: clamp(28px, 4vw, 48px);
  }
  .list {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--line);
  }
  li {
    display: grid;
    grid-template-columns: 120px 1fr;
    gap: 24px;
    padding: 28px 0;
    border-bottom: 1px solid var(--line);
  }
  .year {
    font: 700 2rem/1 var(--f-display);
    background: linear-gradient(120deg, var(--accent), var(--accent-2));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  h3 {
    font-size: clamp(1.15rem, 2vw, 1.45rem);
    line-height: 1.3;
    margin-bottom: 10px;
    max-width: 50ch;
  }
  .authors {
    color: var(--muted);
    margin-bottom: 6px;
  }
  .authors :global(b) {
    color: var(--fg);
    font-weight: 600;
  }
  .venue {
    font-size: 0.78rem;
    color: var(--muted);
    margin: 0;
  }
  @media (max-width: 640px) {
    li {
      grid-template-columns: 1fr;
      gap: 8px;
    }
  }
</style>
